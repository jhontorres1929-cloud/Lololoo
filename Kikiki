    AimBox.Parent = workspace

    AimLine = Instance.new("Beam")
    AimLine.Name = "HOLD_JUP_WHITE_LINE"
    AimLine.Color = ColorSequence.new(Color3.new(1, 1, 1))
    AimLine.Width0 = 0.025
    AimLine.Width1 = 0.025
    AimLine.FaceCamera = true
    AimLine.LightEmission = 1
    AimLine.Parent = workspace
end

-- DETENER ACTUALIZACIONES
local function StopAimbot()
    Aimbot = false
    Target = nil

    if TeleportConnection then
        TeleportConnection:Disconnect()
        TeleportConnection = nil
    end

    if VisualConnection then
        VisualConnection:Disconnect()
        VisualConnection = nil
    end

    RemoveAimVisuals()

    local Character = LP.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Humanoid.WalkSpeed = NormalSpeed
    end

    AimbotButton.Text = "AIMBOT : OFF"
    AimbotButton.BackgroundColor3 = Color3.fromRGB(35, 35, 43)
end

-- ACTIVAR / DESACTIVAR
AimbotButton.MouseButton1Click:Connect(function()
    if Aimbot then
        StopAimbot()
        return
    end

    Aimbot = true
    AimbotButton.Text = "AIMBOT : ON"
    AimbotButton.BackgroundColor3 = Color3.fromRGB(45, 90, 55)

    CreateAimVisuals()

    -- ACTUALIZAR TELETRANSPORTE EN HEARTBEAT
    TeleportConnection = RunService.Heartbeat:Connect(function()
        if not Aimbot then
            return
        end

        local Character = LP.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

        Target = GetClosestPlayer()

        if Humanoid then
            Humanoid.WalkSpeed = AimbotSpeed
        end

        if Root and Target and Target.Character then
            local TargetRoot = Target.Character:FindFirstChild("HumanoidRootPart")
            local TargetHumanoid = Target.Character:FindFirstChildOfClass("Humanoid")

            if TargetRoot and TargetHumanoid and TargetHumanoid.Health > 0 then
                Root.CFrame = TargetRoot.CFrame * CFrame.new(0, 0, 2)
            end
        end
    end)

    -- ACTUALIZAR VISUALES Y CÁMARA
    VisualConnection = RunService.RenderStepped:Connect(function()
        if not Aimbot then
            return
        end

        local Character = LP.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")

        Target = GetClosestPlayer()

        if Target and Target.Character then
            local Head = Target.Character:FindFirstChild("Head")

            if Head then
                Camera = workspace.CurrentCamera

                if Camera then
                    Camera.CFrame = CFrame.lookAt(
                        Camera.CFrame.Position,
                        Head.Position
                    )
                end

                if AimBox then
                    AimBox.Adornee = Target.Character
                end

                if Root and AimLine then
                    LineA0 = Root:FindFirstChild("HOLD_JUP_LINE_START")

                    if not LineA0 then
                        LineA0 = Instance.new("Attachment")
                        LineA0.Name = "HOLD_JUP_LINE_START"
                        LineA0.Parent = Root
                    end

                    LineA1 = Head:FindFirstChild("HOLD_JUP_LINE_END")

                    if not LineA1 then
                        LineA1 = Instance.new("Attachment")
                        LineA1.Name = "HOLD_JUP_LINE_END"
                        LineA1.Parent = Head
                    end

                    AimLine.Attachment0 = LineA0
                    AimLine.Attachment1 = LineA1
                end
            end
        elseif AimBox then
            AimBox.Adornee = nil
        end
    end)
end)

-- ARRASTRAR MENÚ
local Dragging = false
local DragStart
local StartPosition

Header.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position
    end
end)

UIS.InputChanged:Connect(function(Input)
    if not Dragging then
        return
    end

    if Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch then

        local Delta = Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = false
    end
end)

